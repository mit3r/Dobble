{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build All",
      "type": "shell",
      "command": "cmake --build build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Build: Game Server",
      "type": "shell",
      "command": "cmake --build build --target dobble_gameserver",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Build: Lobby Server",
      "type": "shell",
      "command": "cmake --build build --target dobble_lobbyserver",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Build: Client",
      "type": "shell",
      "command": "cmake --build build --target dobble_client",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Run Web Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}