{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Dobble: Game Server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dobble_gameserver",
      "args": [
        "127.0.0.1",
        "8000"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build: Game Server"
    },
    {
      "name": "Launch Dobble: Lobby Server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dobble_lobbyserver",
      "args": [
        "127.0.0.1",
        "8000"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build: Lobby Server"
    },
    {
      "name": "Launch Dobble: Client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dobble_client",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DOBBLE_DEV_URL",
          "value": "http://172.20.96.1:5173"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build: Client"
    }
  ]
}